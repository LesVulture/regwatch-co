# Supabase — proyecto de regwatch-co (NO el de Kodia)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión de Postgres, para `pnpm db:load`. Supabase → Project
# Settings → Database → Connection string. Lleva la contraseña de la base:
# va en .env (gitignored) y NUNCA en un commit.
SUPABASE_DB_URL=

# Anthropic — clasificador y extractor de la capa de validación (§14)
ANTHROPIC_API_KEY=

# Voyage — embeddings y rerank (§8.2)
VOYAGE_API_KEY=

# Mistral — OCR de escaneados (§7)
MISTRAL_API_KEY=

# Identidad del recolector. Debe ser la MISMA constante que se envía como
# User-Agent y la que se usa para evaluar robots.txt (§7).
REGWATCH_USER_AGENT="regwatch-co/0.1 (+https://github.com/LesVulture/regwatch-co)"
