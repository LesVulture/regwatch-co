# dependencias
node_modules/
.pnpm-store/

# builds
dist/
.next/
*.tsbuildinfo

# entorno — nunca versionar credenciales
.env
.env.*
!.env.example

# caché de capturas crudas (se regenera; el archivo canónico vive fuera del repo)
.cache/
collectors/.raw/

# artefactos intermedios de recolección: derivados y regenerables, como el
# grafo o el índice. La fuente de verdad es la fuente primaria, no esto.
artefactos/

# artefactos de sesión
*.log
.DS_Store

# Generado por Next 16 en cada arranque (reglas para agentes). Útil en local,
# ruido en un repo público que ya cura su propio CLAUDE.md y GOVERNANCE.md.
web/AGENTS.md
web/CLAUDE.md
